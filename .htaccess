# ============================================================
#  AL SHAHAD SAE COMMERCIAL — alshahad.net
#  إعدادات الخادم: الأمان، التحويلات، الروابط النظيفة، السرعة
# ============================================================

Options -Indexes
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# —— 1) فرض HTTPS ——
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# —— 2) توحيد الدومين: www ← بدون www ——
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# —— 3) الصفحة الرئيسية أولاً: /index أو /index.html ← / ——
#    لا بد أن تسبق القاعدة العامة، وإلا صار التحويل على خطوتين.
RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?] [NC]
RewriteRule ^ / [R=301,L]

# —— روابط نظيفة: /contracting.html ← /contracting ——
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# تقديم ملف .html عند طلب الرابط النظيف
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# —— 4) صفحة 404 ——
ErrorDocument 404 /404.html
</IfModule>

# ============================================================
#  الأمان — منع الوصول للملفات الحساسة
# ============================================================
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

<FilesMatch "\.(json|md|py|log|sql|bak|ini|yml|yaml)$">
  Require all denied
</FilesMatch>

# مجلد النسخ الاحتياطية للطلبات — ممنوع نهائياً من الويب
<IfModule mod_rewrite.c>
  RewriteRule ^leads/ - [F,L]
  RewriteRule ^\.claude/ - [F,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# ============================================================
#  السرعة — الضغط
# ============================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml application/rss+xml
  AddOutputFilterByType DEFLATE font/woff2 application/vnd.ms-fontobject
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>

# ============================================================
#  السرعة — التخزين المؤقت في المتصفح
# ============================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                        "access plus 1 month"

  ExpiresByType text/html               "access plus 0 seconds"
  ExpiresByType application/xml         "access plus 0 seconds"

  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"

  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/x-icon            "access plus 1 year"

  ExpiresByType font/woff2              "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|webp|jpg|jpeg|png|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # ملف القياس يتغيّر كلما أُضيفت إحالة ناجحة جديدة — نمنع تخزينه الدائم
  # حتى لا يبقى الزوار على نسخة قديمة بلا معرّفات.
  <Files "analytics.js">
    Header set Cache-Control "public, max-age=600, must-revalidate"
  </Files>
  <FilesMatch "\.(html|xml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ============================================================
#  أنواع الملفات
# ============================================================
<IfModule mod_mime.c>
  AddType image/webp                  .webp
  AddType application/manifest+json   .webmanifest
  AddType font/woff2                  .woff2
  AddCharset UTF-8                    .html .css .js .xml .json
</IfModule>
